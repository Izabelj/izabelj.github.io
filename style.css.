```css
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f5a7c4;
  color: #171317;
  font-family: "DM Sans", sans-serif;
  overflow-x: hidden;
}

::selection {
  background: #171317;
  color: #f5a7c4;
}

a {
  color: inherit;
  text-decoration: none;
}


/* NAVIGATION */

nav {
  height: 86px;
  padding: 0 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(23,19,23,.18);

  position: sticky;
  top: 0;

  background: rgba(245,167,196,.86);
  backdrop-filter: blur(14px);

  z-index: 10;
}

.logo {
  font-weight: 700;
  letter-spacing: .08em;
  font-size: 18px;
}

.logo span {
  font-family: "Playfair Display";
  font-style: italic;
}

.nav-links {
  display: flex;
  gap: 34px;
  font-size: 13px;
}

.nav-links a {
  position: relative;
}

.nav-links a:after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -5px;
  width: 0;
  height: 1px;
  background: #171317;
  transition: .3s;
}

.nav-links a:hover:after {
  width: 100%;
}

.nav-cta {
  border: 1px solid #171317;
  border-radius: 999px;
  padding: 10px 17px;
  font-size: 12px;
  font-weight: 600;
}


/* HERO */

.hero {
  min-height: calc(100vh - 86px);

  padding: 9vw 8vw;

  display: grid;
  grid-template-columns: 1.25fr .75fr;

  gap: 7vw;

  align-items: center;
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .18em;
  font-weight: 700;

  display: flex;
  gap: 10px;
  align-items: center;
}

.eyebrow span {
  width: 8px;
  height: 8px;

  background: #171317;

  border-radius: 50%;

  display: inline-block;
}

.hero h1 {
  font-size: clamp(56px, 8.4vw, 126px);

  line-height: .89;

  letter-spacing: -.07em;

  margin: 28px 0;
}

.hero h1 em {
  font-family: "Playfair Display", serif;
  font-weight: 500;
  letter-spacing: -.05em;
}

.hero-text {
  max-width: 510px;

  font-size: 17px;

  line-height: 1.65;
}

.hero-actions {
  display: flex;

  align-items: center;

  gap: 28px;

  margin-top: 35px;
}

.button {
  padding: 15px 21px;

  border-radius: 999px;

  font-size: 12px;

  font-weight: 700;
}

.primary {
  background: #171317;
  color: #fff;
}

.text-link {
  font-size: 12px;
  font-weight: 700;
}


/* HERO CARD */

.hero-card {
  height: 510px;

  max-width: 390px;
  width: 100%;

  justify-self: end;

  background: #f8dfd0;

  border-radius: 220px 220px 20px 20px;

  padding: 30px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  overflow: hidden;

  position: relative;
}

.orb {
  width: 230px;
  height: 230px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      #fff5ee,
      #ef729f 55%,
      #171317 100%
    );

  align-self: center;

  margin-top: 50px;

  box-shadow:
    0 20px 70px rgba(23,19,23,.16);
}

.card-label {
  font-size: 10px;
  letter-spacing: .18em;
}

.card-title {
  font-size: 34px;

  line-height: 1.02;

  letter-spacing: -.05em;
}

.card-title em {
  font-family: "Playfair Display";
  font-weight: 500;
}

.card-bottom {
  display: flex;

  justify-content: space-between;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .12em;
}


/* MARQUEE */

.marquee {
  border-top: 1px solid rgba(23,19,23,.2);
  border-bottom: 1px solid rgba(23,19,23,.2);

  padding: 18px 0;

  overflow: hidden;

  white-space: nowrap;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: .14em;
}

.marquee div {
  animation: move 20s linear infinite;
}

@keyframes move {
  to {
    transform: translateX(-30%);
  }
}


/* SECTIONS */

.section {
  padding: 120px 8vw;
}

.section-number {
  font-size: 10px;

  letter-spacing: .18em;

  font-weight: 700;

  margin-bottom: 60px;
}


/* ABOUT */

.about {
  background: #f8dfd0;
}

.about-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 9vw;
}

.section h2 {
  font-size: clamp(48px, 6vw, 88px);

  line-height: .92;

  letter-spacing: -.065em;

  margin: 0;
}

.section h2 em {
  font-family: "Playfair Display", serif;

  font-weight: 500;

  letter-spacing: -.05em;
}

.large {
  font-size: 26px;

  line-height: 1.3;

  margin-top: 0;
}

.about p:not(.large) {
  line-height: 1.7;

  max-width: 530px;
}

.pill-row {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 35px;
}

.pill-row span {
  border: 1px solid rgba(23,19,23,.3);

  padding: 9px 13px;

  border-radius: 999px;

  font-size: 11px;
}


/* WORK */

.work {
  background: #f5a7c4;
}

.section-heading {
  display: flex;

  justify-content: space-between;

  align-items: end;

  margin-bottom: 55px;
}

.section-heading p {
  max-width: 300px;

  font-size: 12px;

  line-height: 1.6;
}

.projects {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 18px;
}

.project {
  border-radius: 16px;

  overflow: hidden;
}

.project-pink {
  background: #ed6f9d;
}

.project-cream {
  background: #f8dfd0;
}

.project-dark {
  background: #171317;

  color: #fff;
}

.project-top {
  display: flex;

  justify-content: space-between;

  padding: 20px;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .12em;

  opacity: .8;
}

.project-art {
  height: 280px;

  margin: 0 16px;

  display: flex;

  align-items: center;

  justify-content: center;
}


/* PROJECT 1 */

.project-pink .project-art {
  background: #f7b7ce;
}

.chart-lines {
  width: 70%;

  height: 140px;

  border-bottom: 1px solid #171317;

  display: flex;

  align-items: end;

  gap: 10px;
}

.chart-lines i {
  display: block;

  flex: 1;

  background: #171317;
}

.chart-lines i:nth-child(1) {
  height: 25%;
}

.chart-lines i:nth-child(2) {
  height: 43%;
}

.chart-lines i:nth-child(3) {
  height: 62%;
}

.chart-lines i:nth-child(4) {
  height: 92%;
}

.project-art > b {
  position: absolute;

  font-size: 32px;

  margin: -170px 0 0 120px;
}


/* PROJECT 2 */

.dashboard {
  background: white;

  padding: 20px;

  width: 75%;

  box-shadow: 0 20px 40px rgba(23,19,23,.1);
}

.dashboard span,
.dashboard small {
  font-size: 9px;

  display: block;
}

.dashboard strong {
  font-size: 38px;

  display: block;

  margin: 6px 0;
}

.mini-bars {
  height: 65px;

  display: flex;

  align-items: end;

  gap: 7px;

  border-bottom: 1px solid #ddd;
}

.mini-bars i {
  flex: 1;

  background: #171317;
}

.mini-bars i:nth-child(1) {
  height: 30%;
}

.mini-bars i:nth-child(2) {
  height: 48%;
}

.mini-bars i:nth-child(3) {
  height: 38%;
}

.mini-bars i:nth-child(4) {
  height: 68%;
}

.mini-bars i:nth-child(5) {
  height: 55%;
}

.mini-bars i:nth-child(6) {
  height: 90%;
}


/* PROJECT 3 */

.social-card {
  width: 78%;
  height: 175px;

  border: 1px solid rgba(255,255,255,.3);

  padding: 20px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;
}

.social-card small {
  font-size: 8px;

  letter-spacing: .18em;
}

.social-card strong {
  font-size: 27px;

  line-height: 1;

  letter-spacing: -.05em;
}


/* PROJECT INFO */

.project-info {
  padding: 10px 20px 25px;
}

.project-info h3 {
  font-size: 21px;

  margin: 8px 0;
}

.project-info p {
  font-size: 11px;

  line-height: 1.6;

  opacity: .75;

  min-height: 54px;
}

.project-link {
  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .1em;

  font-weight: 700;
}


/* EXPERIENCE */

.experience {
  background: #f8dfd0;
}

.experience-grid {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 9vw;
}

.timeline {
  border-top: 1px solid rgba(23,19,23,.25);
}

.timeline-item {
  display: grid;

  grid-template-columns: 130px 1fr;

  padding: 25px 0;

  border-bottom: 1px solid rgba(23,19,23,.25);
}

.timeline-item > span {
  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .12em;

  opacity: .65;
}

.timeline-item h3 {
  margin: 0 0 5px;

  font-size: 18px;
}

.timeline-item p {
  margin: 0;

  font-size: 11px;

  opacity: .65;
}


/* CONTACT */

.contact {
  background: #171317;

  color: #f8dfd0;

  min-height: 80vh;

  display: flex;

  align-items: center;
}

.contact-inner {
  max-width: 900px;
}

.contact .eyebrow span {
  background: #f8dfd0;
}

.contact h2 {
  font-size: clamp(65px, 10vw, 145px);

  line-height: .85;

  letter-spacing: -.07em;

  margin: 30px 0;
}

.contact-inner > p:not(.eyebrow) {
  max-width: 430px;

  line-height: 1.6;

  opacity: .7;
}

.email {
  font-family: "Playfair Display";

  font-style: italic;

  font-size: clamp(24px, 3vw, 42px);

  display: inline-block;

  margin-top: 30px;

  border-bottom: 1px solid #f8dfd0;
}

.socials {
  display: flex;

  gap: 25px;

  margin-top: 60px;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: .12em;
}

.socials a {
  position: relative;
}

.socials a:after {
  content: "";

  position: absolute;

  left: 0;

  bottom: -5px;

  width: 0;

  height: 1px;

  background: #f8dfd0;

  transition: .3s;
}

.socials a:hover:after {
  width: 100%;
}


/* FOOTER */

footer {
  padding: 25px 8vw;

  background: #171317;

  color: #f8dfd0;

  border-top: 1px solid rgba(248,223,208,.2);

  display: flex;

  justify-content: space-between;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .12em;
}


/* ANIMATION */

.reveal {
  opacity: 0;

  transform: translateY(25px);

  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.visible {
  opacity: 1;

  transform: none;
}


/* MOBILE */

@media (max-width: 800px) {

  nav {
    height: 70px;

    padding: 0 5vw;
  }

  .nav-links {
    display: none;
  }

  .nav-cta {
    padding: 8px 13px;
  }

  .hero {
    grid-template-columns: 1fr;

    padding: 80px 7vw;
  }

  .hero-card {
    justify-self: start;

    height: 430px;

    margin-top: 20px;
  }

  .hero h1 {
    font-size: 62px;
  }

  .section {
    padding: 85px 7vw;
  }

  .about-grid,
  .experience-grid {
    grid-template-columns: 1fr;

    gap: 50px;
  }

  .projects {
    grid-template-columns: 1fr;
  }

  .section-heading {
    display: block;
  }

  .section-heading p {
    margin-top: 25px;
  }

  .project-art {
    height: 240px;
  }

  .timeline-item {
    grid-template-columns: 90px 1fr;
  }

  .contact {
    min-height: 70vh;
  }

  footer {
    padding: 22px 7vw;

    gap: 20px;

    flex-direction: column;
  }

}
```
