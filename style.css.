```css
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  font-family: "DM Sans", sans-serif;

  color: #241520;

  background: #f8b7cd;

  overflow-x: hidden;
}

::selection {
  background: #241520;
  color: #f8b7cd;
}

a {
  color: inherit;
  text-decoration: none;
}


/* ================= NAV ================= */

nav {
  height: 82px;

  padding: 0 6vw;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(36,21,32,.2);

  position: sticky;
  top: 0;

  z-index: 20;

  background: rgba(248,183,205,.9);

  backdrop-filter: blur(15px);
}

.logo {
  font-size: 20px;

  font-weight: 700;

  letter-spacing: .08em;
}

.logo span {
  font-family: "Playfair Display";

  font-style: italic;
}

.nav-links {
  display: flex;

  gap: 30px;

  font-size: 12px;

  font-weight: 600;
}

.nav-links a {
  transition: .25s;
}

.nav-links a:hover {
  opacity: .5;
}

.nav-button {
  border: 1px solid #241520;

  border-radius: 999px;

  padding: 10px 17px;

  font-size: 11px;

  font-weight: 700;
}


/* ================= HERO ================= */

.hero {
  min-height: calc(100vh - 82px);

  padding: 8vw 8vw;

  display: grid;

  grid-template-columns: 1.1fr .9fr;

  align-items: center;

  gap: 6vw;

  background:
    radial-gradient(
      circle at 90% 20%,
      #d8c7f5 0,
      #d8c7f5 15%,
      transparent 16%
    ),

    #f8b7cd;
}

.eyebrow {
  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: .18em;

  font-weight: 700;
}

.hero h1 {
  font-size: clamp(60px, 8.5vw, 125px);

  line-height: .87;

  letter-spacing: -.07em;

  margin: 25px 0;
}

.hero h1 span {
  display: block;

  font-family: "Playfair Display";

  font-style: italic;

  font-weight: 500;
}

.hero-description {
  max-width: 560px;

  font-size: 17px;

  line-height: 1.65;
}

.hero-buttons {
  display: flex;

  align-items: center;

  gap: 25px;

  margin-top: 35px;
}

.button {
  padding: 15px 22px;

  border-radius: 999px;

  font-size: 12px;

  font-weight: 700;
}

.button.dark {
  background: #241520;

  color: white;
}

.simple-link {
  font-size: 12px;

  font-weight: 700;
}


/* HERO VISUAL */

.hero-visual {
  height: 520px;

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;
}

.pink-circle {
  width: 390px;

  height: 390px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 30% 25%,
      #fff0f5,
      #f06292 45%,
      #c43f73 100%
    );

  display: flex;

  align-items: center;

  justify-content: center;

  box-shadow:
    25px 35px 80px rgba(100,30,60,.2);
}

.circle-text {
  font-size: 70px;

  font-weight: 700;

  letter-spacing: -.08em;

  color: white;

  transform: rotate(-12deg);
}

.floating-card {
  position: absolute;

  padding: 15px 18px;

  background: #fff0e6;

  border-radius: 12px;

  box-shadow: 0 20px 50px rgba(36,21,32,.15);

  z-index: 2;
}

.card-one {
  top: 30px;

  left: 5px;

  font-size: 11px;

  font-weight: 700;

  transform: rotate(-7deg);
}

.card-two {
  bottom: 35px;

  right: 0;

  display: flex;

  flex-direction: column;

  gap: 5px;
}

.card-two small {
  font-size: 8px;

  letter-spacing: .15em;
}

.card-two strong {
  font-family: "Playfair Display";

  font-size: 27px;
}

.card-two span {
  font-size: 9px;
}


/* ================= INTRO ================= */

.intro {
  padding: 130px 12vw;

  background: #d8c7f5;

  text-align: center;
}

.big-statement {
  max-width: 1000px;

  margin: auto;

  font-size: clamp(40px, 6vw, 82px);

  line-height: .95;

  letter-spacing: -.06em;
}

.big-statement em {
  font-family: "Playfair Display";

  font-weight: 500;
}

.big-statement strong {
  display: block;

  margin-top: 15px;
}


/* ================= GENERAL ================= */

.section {
  padding: 120px 8vw;
}

.section-label {
  font-size: 10px;

  font-weight: 700;

  letter-spacing: .18em;

  margin-bottom: 60px;
}

.small-heading {
  font-size: 10px;

  font-weight: 700;

  letter-spacing: .18em;
}

.two-column {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 9vw;
}

.section h2 {
  font-size: clamp(48px, 6vw, 88px);

  line-height: .9;

  letter-spacing: -.065em;

  margin: 20px 0 0;
}

.section h2 em {
  font-family: "Playfair Display";

  font-weight: 500;
}

.text-column {
  max-width: 550px;
}

.large-text {
  font-size: 27px;

  line-height: 1.3;
}

.text-column p {
  line-height: 1.7;
}


/* ================= ABOUT ================= */

.about {
  background: #fff0e6;
}


/* ================= SKILLS ================= */

.skills {
  background: #f8b7cd;
}

.skills-heading {
  display: flex;

  justify-content: space-between;

  align-items: end;

  margin-bottom: 60px;
}

.skills-heading > p {
  max-width: 320px;

  font-size: 12px;

  line-height: 1.6;
}

.skill-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 16px;
}

.skill-card {
  min-height: 260px;

  padding: 25px;

  border-radius: 15px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.skill-card:hover {
  transform: translateY(-8px);

  box-shadow:
    0 20px 45px rgba(36,21,32,.12);
}

.skill-card span {
  font-size: 10px;

  font-weight: 700;
}

.skill-card h3 {
  font-size: 27px;

  letter-spacing: -.05em;

  margin: 30px 0 5px;
}

.skill-card p {
  font-size: 12px;

  line-height: 1.6;

  margin: 0;
}

.skill-card.pink {
  background: #f06292;
}

.skill-card.lavender {
  background: #d8c7f5;
}

.skill-card.cream {
  background: #fff0e6;
}

.skill-card.coral {
  background: #ff8a80;
}

.skill-card.dark {
  background: #241520;

  color: #fff0e6;
}

.skill-card.pink-light {
  background: #f7d2e0;
}


/* ================= WORK ================= */

.work {
  background: #ff8a80;
}

.work-heading {
  display: flex;

  justify-content: space-between;

  align-items: end;

  margin-bottom: 60px;
}

.work-heading > p {
  max-width: 320px;

  font-size: 12px;

  line-height: 1.6;
}

.projects {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 18px;
}

.project {
  min-height: 520px;

  padding: 20px;

  border-radius: 16px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  overflow: hidden;
}

.project-one {
  background: #f06292;
}

.project-two {
  background: #fff0e6;
}

.project-three {
  background: #241520;

  color: #fff0e6;
}

.project-number {
  font-size: 10px;

  font-weight: 700;

  letter-spacing: .15em;
}

.project-graphic {
  height: 240px;

  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;
}

.graph {
  width: 75%;

  height: 150px;

  display: flex;

  align-items: end;

  gap: 10px;

  border-bottom: 1px solid #241520;
}

.graph i {
  flex: 1;

  background: #241520;
}

.graph i:nth-child(1) {
  height: 25%;
}

.graph i:nth-child(2) {
  height: 45%;
}

.graph i:nth-child(3) {
  height: 60%;
}

.graph i:nth-child(4) {
  height: 78%;
}

.graph i:nth-child(5) {
  height: 95%;
}

.project-graphic strong {
  position: absolute;

  font-size: 35px;

  transform: translate(50px, -80px);
}

.analytics-box {
  margin: auto;

  width: 85%;

  padding: 25px;

  background: white;

  color: #241520;

  box-shadow: 0 20px 50px rgba(36,21,32,.12);
}

.analytics-box small {
  font-size: 8px;

  letter-spacing: .15em;
}

.analytics-box strong {
  display: block;

  font-size: 45px;

  margin: 5px 0;
}

.analytics-box span {
  font-size: 10px;
}

.analytics-bars {
  height: 65px;

  margin-top: 20px;

  display: flex;

  align-items: end;

  gap: 7px;
}

.analytics-bars i {
  flex: 1;

  background: #241520;
}

.analytics-bars i:nth-child(1) {
  height: 30%;
}

.analytics-bars i:nth-child(2) {
  height: 50%;
}

.analytics-bars i:nth-child(3) {
  height: 40%;
}

.analytics-bars i:nth-child(4) {
  height: 65%;
}

.analytics-bars i:nth-child(5) {
  height: 58%;
}

.analytics-bars i:nth-child(6) {
  height: 90%;
}

.campaign-box {
  width: 85%;

  height: 230px;

  margin: auto;

  padding: 25px;

  border: 1px solid rgba(255,255,255,.35);

  display: flex;

  flex-direction: column;

  justify-content: space-between;
}

.campaign-box small {
  font-size: 8px;

  letter-spacing: .18em;
}

.campaign-box strong {
  font-size: 34px;

  line-height: .95;

  letter-spacing: -.06em;
}

.campaign-box em {
  display: block;

  font-family: "Playfair Display";

  font-weight: 500;
}

.project-content p {
  font-size: 9px;

  letter-spacing: .15em;

  font-weight: 700;
}

.project-content h3 {
  font-size: 28px;

  letter-spacing: -.05em;

  margin: 8px 0;
}

.project-content span {
  font-size: 10px;

  opacity: .7;
}


/* ================= EXPERIENCE ================= */

.experience {
  background: #d8c7f5;
}

.experience-layout {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 9vw;
}

.timeline {
  border-top: 1px solid rgba(36,21,32,.25);
}

.timeline-row {
  display: grid;

  grid-template-columns: 120px 1fr;

  gap: 20px;

  padding: 27px 0;

  border-bottom: 1px solid rgba(36,21,32,.25);
}

.timeline-row > span {
  font-size: 9px;

  letter-spacing: .12em;

  opacity: .6;
}

.timeline-row h3 {
  margin: 0 0 5px;

  font-size: 18px;
}

.timeline-row p {
  margin: 0;

  font-size: 11px;

  opacity: .6;
}


/* ================= BEYOND ================= */

.beyond {
  padding: 130px 8vw;

  background: #f8b7cd;

  text-align: center;
}

.beyond-inner {
  max-width: 950px;

  margin: auto;
}

.beyond h2 {
  font-size: clamp(55px, 8vw, 110px);

  line-height: .9;

  letter-spacing: -.07em;

  margin: 25px 0;
}

.beyond h2 em {
  font-family: "Playfair Display";

  font-weight: 500;
}

.beyond-inner > p:not(.small-heading) {
  font-size: 14px;

  opacity: .7;
}

.interest-list {
  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 10px;

  margin-top: 50px;
}

.interest-list span {
  padding: 12px 18px;

  border: 1px solid rgba(36,21,32,.4);

  border-radius: 999px;

  font-size: 10px;

  font-weight: 700;

  letter-spacing: .12em;
}


/* ================= CONTACT ================= */

.contact {
  min-height: 85vh;

  padding: 120px 8vw;

  background: #241520;

  color: #fff0e6;

  display: flex;

  align-items: center;
}

.contact-content {
  max-width: 1000px;
}

.contact h2 {
  font-size: clamp(60px, 9vw, 135px);

  line-height: .85;

  letter-spacing: -.07em;

  margin: 30px 0;
}

.contact h2 em {
  font-family: "Playfair Display";

  font-weight: 500;

  display: block;
}

.contact-content > p:not(.eyebrow) {
  max-width: 450px;

  line-height: 1.6;

  opacity: .7;
}

.email {
  display: inline-block;

  margin-top: 35px;

  font-family: "Playfair Display";

  font-style: italic;

  font-size: clamp(25px, 3vw, 45px);

  border-bottom: 1px solid #fff0e6;
}

.social-links {
  display: flex;

  gap: 30px;

  margin-top: 60px;
}

.social-links a {
  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .15em;
}


/* ================= FOOTER ================= */

footer {
  padding: 25px 8vw;

  background: #241520;

  color: #fff0e6;

  border-top: 1px solid rgba(255,255,255,.15);

  display: flex;

  justify-content: space-between;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .12em;
}


/* ================= MOBILE ================= */

@media (max-width: 800px) {

  nav {
    height: 70px;

    padding: 0 6vw;
  }

  .nav-links {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;

    padding: 75px 7vw;
  }

  .hero h1 {
    font-size: 62px;
  }

  .hero-visual {
    height: 400px;
  }

  .pink-circle {
    width: 300px;

    height: 300px;
  }

  .circle-text {
    font-size: 55px;
  }

  .section {
    padding: 90px 7vw;
  }

  .two-column,
  .experience-layout {
    grid-template-columns: 1fr;

    gap: 50px;
  }

  .skills-heading,
  .work-heading {
    display: block;
  }

  .skills-heading > p,
  .work-heading > p {
    margin-top: 25px;
  }

  .skill-grid,
  .projects {
    grid-template-columns: 1fr;
  }

  .project {
    min-height: 480px;
  }

  .intro {
    padding: 100px 7vw;
  }

  .timeline-row {
    grid-template-columns: 90px 1fr;
  }

  footer {
    flex-direction: column;

    gap: 15px;
  }

}
```

